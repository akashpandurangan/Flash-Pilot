# ---------------------------------------------------------------------------
# Frontend (Vite) - safe to expose to the browser.
# Copy this file to `.env.local` and fill in the values from
# Supabase Dashboard -> Project Settings -> API.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable (anon) key. NEVER put the service-role / secret key here.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Public URL of the deployed app (used for invite / password-reset redirects).
# Defaults to window.location.origin when empty.
VITE_APP_URL=

# ---------------------------------------------------------------------------
# Edge Function secrets - NOT read by Vite. Set them with:
#   supabase secrets set --env-file supabase/functions/.env
# (the file below is git-ignored). Listed here for documentation only.
# ---------------------------------------------------------------------------
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY are injected
# automatically into deployed Edge Functions.
#
# CRON_SECRET=a-long-random-string         # shared secret the cron job sends in x-cron-secret
# APP_URL=https://app.example.com           # where invite links should land
# RESEND_API_KEY=re_xxx                     # optional - enables email delivery
# EMAIL_FROM="Flash Pilot <notifications@yourdomain.com>"
